# Copy this file to `.env` and fill in local values.
# Never commit `.env` or real secrets.

# --- Backend ---
HOST=0.0.0.0
PORT=8080
RUST_LOG=healthii_backend=info,tower_http=info,sqlx=warn

# PostgreSQL
DATABASE_URL=postgres://healthii:healthii@localhost:5433/healthii

# Auth — generate long random values for any non-local environment.
# Example: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
SESSION_SECRET=change-me-to-another-long-random-secret-32ch

# Token lifetime in seconds (default 12 hours)
JWT_TTL_SECONDS=43200

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:1420,http://127.0.0.1:5173,http://localhost:8081

# OpenAPI UI (disable in production)
OPENAPI_ENABLED=true

# --- Object storage ---
# local | s3
STORAGE_PROVIDER=local
STORAGE_PATH=./data/storage

# S3-compatible (MinIO in development)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=healthii-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=healthii
S3_SECRET_KEY=healthii-dev-secret
S3_ALLOW_HTTP=true

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080

# --- Docker Compose (postgres / minio) ---
POSTGRES_USER=healthii
POSTGRES_PASSWORD=healthii
POSTGRES_DB=healthii
POSTGRES_PORT=5433

MINIO_ROOT_USER=healthii
MINIO_ROOT_PASSWORD=healthii-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
